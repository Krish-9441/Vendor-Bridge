<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Purchase Order — <%= po.poNumber %></title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap');
    :root {
      --paper: #EDE6D6;
      --paper-deep: #E4DBC7;
      --paper-line: #C9C0A8;
      --ink: #231F16;
      --ink-soft: #4A4535;
      --muted: #6b6349;
      --oxblood: #8A3223;
      --green: #4B6B4A;
      --card: #F4EFE3;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--paper);
      color: var(--ink);
      font-family: 'IBM Plex Sans', Arial, sans-serif;
      padding: 50px 56px;
      line-height: 1.5;
    }
    .mono { font-family: 'IBM Plex Mono', monospace; }
    /* Status stamp */
    .stamp {
      position: fixed;
      top: 44px;
      right: 56px;
      width: 90px;
      height: 90px;
      border: 2.5px solid var(--green);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      font-size: 9px;
      transform: rotate(-12deg);
      letter-spacing: 0.04em;
      color: var(--green);
      text-transform: uppercase;
      line-height: 1.3;
    }
    /* Header */
    .doc-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 36px;
      border-bottom: 2px solid var(--ink);
      padding-bottom: 26px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'IBM Plex Sans', sans-serif;
      font-weight: 700;
      font-size: 18px;
      margin-bottom: 14px;
      color: var(--ink);
    }
    .brand-mark {
      width: 20px; height: 20px;
      border: 2px solid var(--oxblood);
      border-radius: 50%;
      display: inline-block;
      position: relative;
    }
    .addr {
      font-size: 12.5px;
      color: var(--muted);
      line-height: 1.7;
    }
    .doc-title { text-align: right; }
    .doc-title h1 { font-size: 26px; font-weight: 600; margin-bottom: 6px; font-family: 'IBM Plex Sans', sans-serif; }
    .doc-title .num { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: var(--oxblood); }
    .doc-title .date { font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--muted); margin-top: 4px; }
    /* Meta grid */
    .doc-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 32px;
    }
    .doc-meta .label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      text-transform: uppercase;
      color: var(--muted);
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }
    .doc-meta .block p { font-size: 13.5px; line-height: 1.6; }
    .doc-meta .block p b { display: block; font-size: 14.5px; margin-bottom: 2px; }
    /* Table */
    table.items {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 24px;
    }
    table.items th {
      text-align: left;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      text-transform: uppercase;
      color: var(--muted);
      padding: 10px 4px;
      border-bottom: 1.5px solid var(--ink);
    }
    table.items td {
      padding: 12px 4px;
      border-bottom: 1px solid var(--paper-line);
      font-size: 13.5px;
      color: var(--ink);
    }
    table.items th.num, table.items td.num { text-align: right; font-family: 'IBM Plex Mono', monospace; }
    /* Totals */
    .totals { display: flex; justify-content: flex-end; margin-bottom: 40px; }
    .totals table { border-collapse: collapse; width: 280px; }
    .totals td { padding: 7px 4px; font-size: 13.5px; }
    .totals td.label { color: var(--muted); }
    .totals td.val { text-align: right; font-family: 'IBM Plex Mono', monospace; }
    .totals tr.grand td {
      border-top: 1.5px solid var(--ink);
      padding-top: 12px;
      font-size: 17px;
      font-weight: 600;
    }
    .totals tr.grand td.val { color: var(--oxblood); }
    /* Footer */
    .doc-footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid var(--paper-line);
      font-size: 11.5px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      font-family: 'IBM Plex Mono', monospace;
    }
  </style>
</head>
<body>

  <div class="stamp">PURCHASE<br>ORDER</div>

  <div class="doc-head">
    <div>
      <div class="brand">
        <span class="brand-mark"></span>
        VendorBridge
      </div>
      <div class="addr">
        VendorBridge Corporate<br>
        Procurement Division<br>
        Mumbai, MH 400001
      </div>
    </div>
    <div class="doc-title">
      <h1>Purchase Order</h1>
      <div class="num"><%= po.poNumber %></div>
      <div class="date">Issued <%= new Date(po.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %></div>
    </div>
  </div>

  <div class="doc-meta">
    <div class="block">
      <div class="label">Vendor</div>
      <p>
        <b><%= vendor.companyName %></b>
        <%= vendor.contactEmail %><br>
        <% if (vendor.gstNumber) { %>GSTIN: <%= vendor.gstNumber %><% } %>
      </p>
    </div>
    <div class="block">
      <div class="label">Reference</div>
      <p>
        <b>RFQ: <%= po.rfqId ? po.rfqId.rfqNumber : 'N/A' %></b>
        <%= po.rfqId ? po.rfqId.title : '' %><br>
        Issued By: <%= po.issuedBy ? po.issuedBy.name || 'Admin' : 'Admin' %>
      </p>
    </div>
  </div>

  <table class="items">
    <thead>
      <tr>
        <th>Description</th>
        <th class="num">Qty</th>
        <th class="num">Unit</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% if (items && items.length > 0) { %>
        <% items.forEach(function(item) { %>
          <tr>
            <td><%= item.name %></td>
            <td class="num"><%= item.quantity %></td>
            <td class="num"><%= item.unit %></td>
            <td class="num">—</td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td>Goods/Services as per <%= po.poNumber %></td>
          <td class="num"><%= quotation ? quotation.quantity : 1 %></td>
          <td class="num">—</td>
          <td class="num">₹<%= po.totalAmount.toLocaleString('en-IN') %></td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <div class="totals">
    <table>
      <tr>
        <td class="label">Subtotal</td>
        <td class="val">₹<%= po.totalAmount.toLocaleString('en-IN') %></td>
      </tr>
      <tr>
        <td class="label">Tax</td>
        <td class="val">₹0</td>
      </tr>
      <tr class="grand">
        <td class="label">Total due</td>
        <td class="val">₹<%= po.totalAmount.toLocaleString('en-IN') %></td>
      </tr>
    </table>
  </div>

  <div class="doc-footer">
    <span>Generated automatically · VendorBridge ERP</span>
    <span>Page 1 of 1</span>
  </div>

</body>
</html>
